#include <windows.h>

// Must match IDI_APPICON in SteamOverlayFix.cpp. Id 1 is also what Explorer
// picks up for the .exe icon.
#define IDI_APPICON 101

IDI_APPICON ICON "app.ico"
1           ICON "app.ico"

// Id 1, type 24 (RT_MANIFEST). Written numerically so windres accepts it.
1 24 "SteamOverlayFix.manifest"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION     1,0,0,0
  PRODUCTVERSION  1,0,0,0
  FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
  FILEFLAGS       0
  FILEOS          VOS_NT_WINDOWS32
  FILETYPE        VFT_APP
  FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "AyresIV"
      VALUE "FileDescription",  "Destiny 2 Steam Overlay Fix"
      VALUE "FileVersion",      "1.0.0.0"
      VALUE "InternalName",     "SteamOverlayFix"
      VALUE "OriginalFilename", "SteamOverlayFix.exe"
      VALUE "ProductName",      "Steam Overlay Fix"
      VALUE "ProductVersion",   "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
